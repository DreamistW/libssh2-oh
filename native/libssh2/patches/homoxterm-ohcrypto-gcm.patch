 #if LIBSSH2_AES_GCM
+#ifdef LIBSSH2_OHCRYPTO
+/* OHCRYPTO verifies the tag supplied at init before publishing plaintext. */
+static int
+ohcrypto_gcm_length(LIBSSH2_SESSION *session, unsigned int seqno,
+                    unsigned char *data, size_t size, unsigned int *len,
+                    void **abstract)
+{
+    (void)session;
+    (void)seqno;
+    (void)abstract;
+    if(size < 4)
+        return LIBSSH2_ERROR_DECRYPT;
+    *len = _libssh2_ntohu32(data);
+    return 0;
+}
